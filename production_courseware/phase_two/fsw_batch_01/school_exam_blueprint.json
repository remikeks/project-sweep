        {
          "criterion": "Accurate activity and outcome distinction",
          "marks": 2
        },
        {
          "criterion": "Appropriate follow-through checks",
          "marks": 2
        },
        {
          "criterion": "Owner or plan update",
          "marks": 1
        }
      ],
      "human_marking_required": true
    },
    {
      "id": "FSW-WRITTEN-06",
      "type": "SHORT_ANSWER",
      "marks": 5,
      "course_codes": [
        "SWP-035",
        "SWP-036"
      ],
      "prompt": "A learner claims a desk-review paper proves a local agency caused a client's exclusion. Explain the evidence limitation and a defensible assessment response.",
      "model_answer": "A secondary conceptual analysis does not establish the facts or causation in a particular case. Document the person's account, verify the local process and relevant evidence, and use appropriate accountability or supervision routes.",
      "rubric": [
        {
          "criterion": "Research limitation explained",
          "marks": 2
        },
        {
          "criterion": "Local evidence and person-centred assessment",
          "marks": 2
        },
        {
          "criterion": "Appropriate accountability route",
          "marks": 1
        }
      ],
      "human_marking_required": true
    },
    {
      "id": "FSW-WRITTEN-07",
      "type": "ESSAY",
      "marks": 15,
      "course_codes": [
        "SWP-016",
        "SWP-017",
        "SWP-018",
        "SWP-035",
        "SWP-036"
      ],
      "prompt": "Fictional case: an adult preparing for discharge has a long-term condition, transport barriers and an unclear referral handover. The person wants to participate in decisions. Develop a coordinated support plan, explain an information-sharing dilemma, and show how you would review access and outcomes. Identify the limits of your role.",
      "model_answer": "A defensible answer connects the person's priorities and discharge context to assessment, chronic-care support barriers, team responsibilities, proportionate information sharing and a measurable review plan. It identifies clinical decisions outside role, uncertainties and escalation or supervision needs. Alternative safe, justified plans may earn marks.",
      "rubric": [
        {
          "criterion": "Discharge context and person-centred assessment",
          "marks": 3
        },
