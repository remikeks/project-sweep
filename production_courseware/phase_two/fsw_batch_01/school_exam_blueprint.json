    {
      "id": "FSW-WRITTEN-01",
      "type": "SHORT_ANSWER",
      "marks": 5,
      "course_codes": [
        "SWP-016"
      ],
      "prompt": "A person is due to leave hospital but reports an unresolved housing barrier. Identify two matters to verify, the appropriate team consultation and a documented next step.",
      "model_answer": "Check the person's account and current housing or support situation; involve the appropriate discharge team and social support role; agree and document responsibility and follow-up without making a unilateral clinical discharge decision.",
      "rubric": [
        {
          "criterion": "Two relevant checks with the person's participation",
          "marks": 2
        },
        {
          "criterion": "Appropriate interdisciplinary consultation within role",
          "marks": 1
        },
        {
          "criterion": "Agreed action owner and follow-up",
          "marks": 2
        }
      ],
      "human_marking_required": true
    },
    {
      "id": "FSW-WRITTEN-02",
      "type": "SHORT_ANSWER",
      "marks": 5,
      "course_codes": [
        "SWP-017"
      ],
      "prompt": "A person misses a chronic-care appointment because of work hours and transport cost. Explain a respectful assessment and two collaborative support actions.",
      "model_answer": "Explore the person's priorities and reported barriers without assigning blame; check feasible appointment or transport options with the relevant service; agree who will follow up. Do not alter clinical treatment independently.",
      "rubric": [
        {
          "criterion": "Non-judgemental exploration and participation",
          "marks": 2
        },
        {
          "criterion": "Two feasible support actions within role",
          "marks": 2
        },
        {
          "criterion": "Follow-up responsibility",
          "marks": 1
        }
      ],
      "human_marking_required": true
    },
    {
      "id": "FSW-WRITTEN-03",
      "type": "SHORT_ANSWER",
      "marks": 5,
      "course_codes": [
        "SWP-018"
      ],
      "prompt": "Two services each assume the other will contact a family. Describe how to resolve the responsibility gap and record the handover.",
      "model_answer": "Clarify the outstanding need with the person and services; name the responsible role, obtain acceptance and set the contact and review arrangements; record information-sharing authority and outstanding risk as relevant.",
      "rubric": [
        {
          "criterion": "Identify the responsibility gap and relevant need",
          "marks": 1
        },
        {
          "criterion": "Explicit agreed responsibility and acceptance",
          "marks": 2
        },
        {
          "criterion": "Clear documented contact and review arrangements",
          "marks": 2
        }
      ],
      "human_marking_required": true
    },
    {
      "id": "FSW-WRITTEN-04",
      "type": "SHORT_ANSWER",
      "marks": 5,
      "course_codes": [
        "SWP-035"
      ],
      "prompt": "A partner asks for a whole case file for a narrow support decision. Give a reasoned response addressing purpose, authority, participation and proportionality.",
      "model_answer": "Clarify the request and authority, involve the person where appropriate, consider a relevant limited summary, consult on uncertainty and use the approved secure route. A professional request alone does not justify disclosure.",
      "rubric": [
        {
          "criterion": "Purpose and authority checked",
          "marks": 2
        },
        {
          "criterion": "Participation and proportionate information",
          "marks": 2
        },
        {
          "criterion": "Consultation or secure route",
          "marks": 1
        }
      ],
      "human_marking_required": true
    },
    {
      "id": "FSW-WRITTEN-05",
      "type": "SHORT_ANSWER",
      "marks": 5,
      "course_codes": [
        "SWP-036"
      ],
      "prompt": "A referral was sent but no response is recorded. Distinguish activity from outcome and propose a closed-loop review.",
      "model_answer": "Sending is activity rather than evidence of access or benefit. Check receipt and the agreed next step with the person and receiving service, identify barriers, assign responsibility and update the plan.",
